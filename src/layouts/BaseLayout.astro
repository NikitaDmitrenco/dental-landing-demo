---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AppointmentDialog from '../components/AppointmentDialog.astro';
interface Props { title?: string; description?: string }
const { title = 'Dentiva — стоматология с заботой', description = 'Демонстрационный сайт стоматологической клиники Dentiva. Понятный план лечения, внимание к комфорту и бережная профилактика.' } = Astro.props;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="font-sans">
    <a class="skip-link" href="#main-content">Перейти к содержанию</a>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <AppointmentDialog />
  </body>
</html>
